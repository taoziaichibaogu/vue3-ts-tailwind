{
  // 作用：继承 Vue 官方推荐的 DOM/浏览器环境基础 TS 配置
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    /* 项目工程与构建优化 */
    "composite": true, // 作用：启用项目引用（Project References），允许被根 tsconfig 作为子工程引用并支持增量构建
    "incremental": true, // 作用：启用增量编译，复用历史构建缓存以大幅提升二次类型检查速度
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo", // 作用：指定增量编译缓存文件的输出路径，避免污染项目根目录

    /* 语法目标与模块系统 */
    "target": "ES2020", // 作用：指定编译生成/期望的 ECMAScript 目标版本（支持可选链、空值合并等现代特性）
    "useDefineForClassFields": true, // 作用：符合 ECMAScript 最新规范使用 Object.defineProperty 定义类属性字段，避免原型覆盖
    "module": "ESNext", // 作用：指定模块代码系统为最新 ES 标准（import/export），便于 Vite 等打包工具进行 Tree-shaking 优化
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ], // 作用：指定要包含的内置类型声明库（包含 ES2020 语法以及浏览器 DOM、DOM 迭代器 API）
    "skipLibCheck": true, // 作用：跳过对所有第三方依赖（node_modules 中的 *.d.ts）的类型检查，显著减少编译检查时间

    /* Bundler 打包器模式（针对 Vite 等现代打包工具） */
    "moduleResolution": "bundler", // 作用：模块解析策略采用专门针对打包工具的 'bundler' 模式，完美支持 package.json 的 exports 条件导出
    "allowImportingTsExtensions": true, // 作用：允许在 import 导入语句中显式书写 .ts/.tsx 等扩展名（需配合 noEmit 使用）
    "isolatedModules": true, // 作用：确保每个文件都可以被单独文件编译器（如 esbuild）独立转译，防止出现单文件无法转译的 TS 语法
    "moduleDetection": "force", // 作用：强制将所有源文件都视为 ES 模块处理（即使文件中没有包含任何 import/export 语句）
    "noEmit": true, // 作用：不生成编译后的 .js 文件（TS 仅用于类型检查，实际构建打包完全交由 Vite 处理）
    "jsx": "preserve", // 作用：保留 JSX/TSX 原始语法不转译，交由 Vue 编译器/插件在后续流程中处理

    /* 代码质量与严格类型检查（Linting） */
    "strict": true, // 作用：开启所有严格类型检查开关（包含 strictNullChecks、noImplicitAny 等），提供最高级别类型安全
    "noUnusedLocals": true, // 作用：检测并报错未使用的局部变量，保持代码干净整洁
    "noUnusedParameters": true, // 作用：检测并报错未使用的函数参数，防止无效参数定义
    "noFallthroughCasesInSwitch": true, // 作用：防止 switch-case 语句中意外遗漏 break 或 return 发生穿透执行

    /* 路径别名映射 */
    "baseUrl": ".", // 作用：解析非相对模块名称时的基准根目录
    "paths": {
      "@/*": [
        "./src/*"
      ]
    } // 作用：配置路径别名映射，让代码中统一使用 @/ 指向 src/ 目录
  },
  /* 包含检查的文件范围 */
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ] // 作用：指定纳入当前工程类型检查的文件与目录匹配规则
}